<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClusterDiag" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/on_amber</item>
        <item name="colorSecondary">@color/digital</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.ClusterDiag.Cluster" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>

    <style name="Widget.ClusterDiag.ThemeButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/on_color</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">104dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.ClusterDiag.SecondaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.ClusterDiag.RereadButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/amber</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="strokeColor">@color/amber</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Text.ClusterDiag.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
