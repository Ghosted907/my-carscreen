<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <package android:name="com.autolink.clusterinteraction" />
        <package android:name="com.autolink.hmi.carsettings" />
        <package android:name="com.autolink.miscservice" />
        <package android:name="com.autolink.carservice" />
        <package android:name="com.autolink.app.vehicleservice" />
        <package android:name="com.autolink.app.avm" />
        <package android:name="com.autolink.voiceassistant" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".T1App"
        android:allowBackup="false"
        android:icon="@drawable/ic_t1"
        android:label="T1"
        android:supportsRtl="true"
        android:theme="@style/Theme.T1">

        <!-- Main UI is display 0 only. No SECONDARY_HOME. Not resizable, so freeform does not park it on the cluster. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.ghosted907.t1launcher.main"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Optional main-display home. No SECONDARY_HOME, so the cluster does not adopt T1. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.ghosted907.t1launcher.main"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ClusterAddonActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:taskAffinity="com.ghosted907.t1launcher.main"
            android:theme="@style/Theme.T1.Overlay"
            android:launchMode="singleTask" />

        <service
            android:name=".T1NotificationListener"
            android:exported="true"
            android:label="T1 media"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".EdgeSwipeService"
            android:exported="true" />

        <service
            android:name=".T1TouchService"
            android:exported="true"
            android:label="T1 remote touch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/t1_touch_service" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Declares capability only; never provisions device owner or activates admin. -->
        <receiver android:name=".ClusterDeviceAdmin" android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/cluster_device_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
    </application>
</manifest>
